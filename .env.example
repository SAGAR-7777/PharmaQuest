# ====================================================================
# PHARMAQUEST — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development
# ====================================================================

# --------------------------------------------------------------------
# 1. RENDER (BACKEND) ENVIRONMENT VARIABLES
# Configure these in Render Dashboard -> Environment Variables
# --------------------------------------------------------------------

# Server Port (Render provides this automatically; defaults to 3000 locally)
PORT=3000

# Groq AI Configuration (Server-Side Only - NEVER expose to browser/client)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Supabase Credentials (Used by backend to serve /api/config to client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Supabase Service Role Key (Server-side admin only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CORS Allowed Origin for Production
# Set to your Vercel frontend URL, e.g. https://pharmaquest.vercel.app
# Leave empty or set to * to allow all origins
ALLOWED_ORIGIN=*

# --------------------------------------------------------------------
# 2. VERCEL (FRONTEND) CONFIGURATION
# --------------------------------------------------------------------
# The frontend is pure static HTML/CSS/JS.
# Set your Render backend URL in js/config.js:
#   export const PRODUCTION_BACKEND_URL = "https://your-backend.onrender.com";
# OR in index.html:
#   window.__PHARMAQUEST_API_URL__ = "https://your-backend.onrender.com";
