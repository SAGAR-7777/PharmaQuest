# PHARMAQUEST — Environment Variables
# Copy this file to .env and configure your keys

# Server Port
PORT=3000

# Supabase Credentials (from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (Used only for server-side administrative tasks, NEVER exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Groq AI Configuration (Server-Side Only - NEVER expose to browser/client)
# Official groq-sdk package is used for ultra-fast D.Pharm study assistance
GROQ_API_KEY=your-GROQ_API_KEY
GROQ_MODEL=qwen/qwen3.8-27b
